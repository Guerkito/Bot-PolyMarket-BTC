class ShadowTracker:
    """
    Registra TODAS las predicciones del modelo — apostemos o no — con el resultado real.
    Genera reporte de calibración por bucket de probabilidad y rango de tiempo al cierre.
    Úsalo corriendo 4-8h para saber exactamente en qué rango de tiempo y prob hay edge real.
    """

    PROB_EDGES  = [0.60, 0.65, 0.70, 0.75, 0.80, 0.85, 0.90, 0.95, 1.01]
    PROB_LABELS = ["60-65%", "65-70%", "70-75%", "75-80%", "80-85%", "85-90%", "90-95%", "95%+"]
    TIME_RANGES = [(10, 20, "10-20s"), (20, 30, "20-30s"), (30, 40, "30-40s"),
                   (40, 50, "40-50s"), (50, 61, "50-60s")]

    def __init__(self):
        self.predictions = []
        self._load()

    def _load(self):
        try:
            if os.path.exists(SHADOW_FILE):
                with open(SHADOW_FILE) as f:
                    raw = json.load(f)
                # Migrar registros viejos que no tengan todas las keys
                defaults = {"result": None, "close_price": None, "bet_placed": False,
                            "key": "", "prob": 0.0, "seconds_left": 0, "target_price": 0.0,
                            "ticker": "", "end_iso": None, "market_id": ""}
                self.predictions = [{**defaults, **p} for p in raw]
        except Exception:
            self.predictions = []

    def _save(self):
        try:
            with open(SHADOW_FILE, "w") as f:
                json.dump(self.predictions, f, indent=2, default=str)
        except Exception:
            pass

    def record(self, asset, side, prob, seconds_left, market_id, target_price, end_iso, ticker, bet_placed):
        """Registra una predicción. Un registro único por (market_id, asset, side)."""
        key = f"{market_id}_{asset}_{side}"
        if any(p["key"] == key for p in self.predictions):
            return
        self.predictions.append({
            "key": key,
            "ts": datetime.now(timezone.utc).isoformat(),
            "asset": asset,
            "side": side,
            "prob": round(prob, 4),
            "seconds_left": seconds_left,
            "market_id": market_id,
            "target_price": target_price,
            "end_iso": end_iso,
            "ticker": ticker,
            "bet_placed": bet_placed,
            "result": None,
            "close_price": None,
        })
        self._save()

    def resolve_pending(self, get_closing_price_fn):
        """Resuelve predicciones pendientes con precio de cierre real."""
        now = datetime.now(timezone.utc)
        changed = False
        for p in self.predictions:
            if p.get("result") is not None or not p.get("end_iso"):
                continue
            end_dt = datetime.fromisoformat(p["end_iso"].replace("Z", "+00:00"))
            if now <= (end_dt + timedelta(seconds=15)):
                continue
            close = get_closing_price_fn(p["ticker"], p["end_iso"])
            if not close:
                continue
            won = (close >= p["target_price"]) if p["side"] == "UP" else (close < p["target_price"])
            p["result"] = "WIN" if won else "LOSS"
            p["close_price"] = close
            changed = True
        if changed:
            self._save()

    def calibration_report(self):
        """Retorna dict con stats de calibración o None si hay menos de 10 datos."""
        resolved = [p for p in self.predictions if p["result"] is not None]
        if len(resolved) < 10:
            return None

        prob_buckets = {lbl: {"n": 0, "wins": 0} for lbl in self.PROB_LABELS}
        time_buckets = {lbl: {"n": 0, "wins": 0} for _, _, lbl in self.TIME_RANGES}

        for p in resolved:
            # bucket de prob
            for i, (lo, hi) in enumerate(zip(self.PROB_EDGES[:-1], self.PROB_EDGES[1:])):
                if lo <= p["prob"] < hi:
                    prob_buckets[self.PROB_LABELS[i]]["n"] += 1
                    if p["result"] == "WIN":
                        prob_buckets[self.PROB_LABELS[i]]["wins"] += 1
                    break
            # bucket de tiempo
            for lo, hi, lbl in self.TIME_RANGES:
                if lo <= p["seconds_left"] < hi:
                    time_buckets[lbl]["n"] += 1
                    if p["result"] == "WIN":
                        time_buckets[lbl]["wins"] += 1
                    break

        for d in list(prob_buckets.values()) + list(time_buckets.values()):
            d["wr"] = (d["wins"] / d["n"] * 100) if d["n"] > 0 else None

        bet_n    = sum(1 for p in resolved if p["bet_placed"])
        bet_wins = sum(1 for p in resolved if p["bet_placed"] and p["result"] == "WIN")
        total_wr = resolved and sum(1 for p in resolved if p["result"] == "WIN") / len(resolved) * 100

        return {
            "total": len(resolved),
            "total_wr": total_wr,
            "prob_buckets": prob_buckets,
            "time_buckets": time_buckets,
            "bet_n": bet_n,
            "bet_wins": bet_wins,
            "bet_wr": (bet_wins / bet_n * 100) if bet_n else None,
        }

    def save_report(self):
        """Escribe shadow_report.txt con el reporte de calibración."""
        rpt = self.calibration_report()
        if not rpt:
            return "Sin datos suficientes (<10 predicciones resueltas)."
        lines = [
            "=" * 45,
            " SHADOW CALIBRATION REPORT",
            f" {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
            "=" * 45,
            f" Total predicciones resueltas : {rpt['total']}",
            f" Win Rate global (shadow)      : {rpt['total_wr']:.1f}%",
            f" Apuestas reales               : {rpt['bet_n']} "
            + (f"({rpt['bet_wr']:.1f}% WR)" if rpt['bet_wr'] is not None else "(sin datos)"),
            "",
            "── Por bucket de probabilidad ──",
        ]
        for lbl, b in rpt["prob_buckets"].items():
            if b["n"] > 0:
                bar = "█" * int(b["wr"] / 5) if b["wr"] else ""
                lines.append(f"  {lbl:8s} {b['wins']:3d}/{b['n']:3d}  {b['wr']:5.1f}%  {bar}")
        lines += ["", "── Por rango de tiempo al cierre ──"]
        for lbl, b in rpt["time_buckets"].items():
            if b["n"] > 0:
                bar = "█" * int(b["wr"] / 5) if b["wr"] else ""
                lines.append(f"  {lbl:7s} {b['wins']:3d}/{b['n']:3d}  {b['wr']:5.1f}%  {bar}")
        text = "\n".join(lines) + "\n"
        try:
            with open(SHADOW_REPORT_FILE, "w") as f:
                f.write(text)
        except Exception:
            pass
        return text

    def pending_count(self):
        return sum(1 for p in self.predictions if p["result"] is None)

    def resolved_count(self):
        return sum(1 for p in self.predictions if p["result"] is not None)


